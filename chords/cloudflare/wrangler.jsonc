// Serves Cozy Chords at shalonely.com/chords. Deploy: node build.mjs && npx wrangler deploy
{
  "name": "cozy-chords",
  "main": "dist/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist/assets", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "shalonely.com/chords", "zone_name": "shalonely.com" },
    { "pattern": "shalonely.com/chords/*", "zone_name": "shalonely.com" }
  ]
}
